# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LLC Inventory PWA configuration
APPS_SCRIPT_API_BASE_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"
APP_PIN="1234"
APPS_SCRIPT_REQUEST_TIMEOUT_MS=45000

# VPS/Discord bot runtime
NODE_ENV=development
LOG_LEVEL=info
DRY_RUN=true
DISCORD_ENABLED=false
APPS_SCRIPT_DRY_RUN=true
SQLITE_PATH=./data/llc-inventory-v2.sqlite
DISCORD_BOT_TOKEN=""
DISCORD_GUILD_ID=""
DISCORD_COMMANDS_CHANNEL_ID=""
DISCORD_ORGANIZER_NACE_CHANNEL_ID=""
DISCORD_ORGANIZER_CARDFESTA_CHANNEL_ID=""
DISCORD_ORGANIZER_OTHER_CHANNEL_ID=""
IMGBB_API_KEY=""

# Image analysis. Label detection is optional; QR fallback still works when disabled.
LABEL_DETECTION_ENABLED=false
LABEL_DETECTOR_PROJECT_DIR=./label-detector
LABEL_DETECTOR_PYTHON=""
LABEL_DETECTOR_WEIGHTS_PATH=""
LABEL_DETECTOR_DEVICE=cpu
LABEL_DETECTOR_IMGSZ=1280
LABEL_DETECTOR_CONF=0.2

# Collectr proxy/relay
COLLECTR_PROXY_ENABLED=false
COLLECTR_PROXY_HOST=127.0.0.1
COLLECTR_PROXY_PORT=8788
COLLECTR_ACCOUNT_ID=""
COLLECTR_CURRENCY="CAD"
COLLECTR_PROXY_BASE_URL=""
COLLECTR_PROXY_SECRET=""
COLLECTR_AUTH_TOKEN=""
COLLECTR_RELAY_BASE_URL=""
COLLECTR_RELAY_SECRET=""
LOCAL_COLLECTR_RELAY_HOST=127.0.0.1
LOCAL_COLLECTR_RELAY_PORT=8790
LOCAL_COLLECTR_RELAY_SECRET=""
LOCAL_COLLECTR_RELAY_DELAY_MS=3000
